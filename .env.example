# Relay development configuration — copy to .env and fill in locally.
# .env is git-ignored and must never be committed (TECHNICAL_SPEC.md §27).
#
# Optional. Destinations are connected in Settings -> Upload destination -> Set
# up, and those credentials live in the OS keychain. This file only pre-seeds a
# build so it ships already connected; a connection made in the application
# takes precedence over it, and a disconnect is not undone by it.
#
# A bot token shipped inside a distributed desktop binary is not a secret.
# This file is acceptable for development or a trusted internal deployment only;
# a public release must move Telegram credentials behind a backend/proxy (§16).

# --- Telegram Bot API destination (§16) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional. Defaults to https://api.telegram.org when unset. Point this at a
# self-hosted Local Bot API Server to lift the 50 MB hosted-API limit.
TELEGRAM_BOT_API_BASE_URL=
