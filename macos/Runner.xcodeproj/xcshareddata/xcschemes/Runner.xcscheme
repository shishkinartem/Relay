   <BuildAction
      parallelizeBuildables = "YES"
      buildImplicitDependencies = "YES">
      <PreActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Regenerate Flutter build configuration"
               scriptText = "# Flutter regenerates macos/Flutter/ephemeral on every `flutter pub get`&#10;# (including the implicit one inside `flutter test`), and writes the&#10;# generated Swift package at its own hardcoded macOS 12.0 floor plus a&#10;# FLUTTER_TARGET that a finished `flutter test integration_test` has already&#10;# deleted. Both make an Xcode Run fail on a tree that `flutter build` is&#10;# perfectly happy with. `--config-only` rewrites them from this project&apos;s&#10;# own settings and does nothing else.&#10;cd &quot;$SRCROOT/..&quot; || exit 1&#10;# FLUTTER_BUILD_NAME / FLUTTER_BUILD_NUMBER reach this pre-action from&#10;# Generated.xcconfig, and flutter_tools refuses to run with them in the&#10;# environment — which failed every xcodebuild-driven build, including&#10;# `flutter build macos`. They are regenerated from pubspec anyway.&#10;env -u FLUTTER_BUILD_NAME -u FLUTTER_BUILD_NUMBER &quot;$FLUTTER_ROOT&quot;/bin/flutter build macos --config-only --debug&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "33CC10EC2044A3C60003C045"
                     BuildableName = "relay.app"
                     BlueprintName = "Runner"
                     ReferencedContainer = "container:Runner.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Run Prepare Flutter Framework Script"
               scriptText = "&quot;$FLUTTER_ROOT&quot;/packages/flutter_tools/bin/macos_assemble.sh prepare&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "33CC10EC2044A3C60003C045"
                     BuildableName = "relay.app"
                     BlueprintName = "Runner"
                     ReferencedContainer = "container:Runner.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PreActions>
