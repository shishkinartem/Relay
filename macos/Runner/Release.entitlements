<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- See DebugProfile.entitlements for why the App Sandbox is off. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- A user-run Telegram Local Bot API Server is reached over loopback
	     (TECHNICAL_SPEC.md §16). That is an outgoing connection, so
	     network.client covers it; network.server is declared because a
	     sandboxed build would otherwise refuse the loopback listener the
	     server itself may want, and it costs nothing while the sandbox is
	     off. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
