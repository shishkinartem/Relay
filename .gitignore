# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
# Not /build/: every workspace package under packages/ has one too, and a
# root-anchored pattern let a 48 MB .dill build cache reach the index.
build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Relay — secrets and local artifacts
# `cov/` is the per-package coverage output directory; `coverage/` above only
# catches the conventionally named one.
cov/
.env
.env.local
*.pem
*.p12
credentials.json
client_secret*.json
coverage/
macos/Runner/Configs/Signing.local.xcconfig
